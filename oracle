-- 1. Ver alunos ativos
SELECT * FROM vw_alunos_ativos;

-- 2. Ver pagamentos atrasados (com cálculo de dias!)
SELECT * FROM vw_pagamentos_atrasados;

-- 3. A mágica da matemática de datas
SELECT 
    nome,
    created_at,
    SYSDATE AS hoje,
    (SYSDATE - created_at) AS dias_desde_criacao
FROM alunos;

-- 4. Limitar resultados (o "LIMIT" do Oracle)
SELECT * FROM planos FETCH FIRST 5 ROWS ONLY;

-- 5. Total de alunos por plano
SELECT 
    p.nome AS plano,
    COUNT(m.id) AS total_alunos,
    SUM(m.valor_total) AS faturamento_total
FROM planos p
LEFT JOIN matriculas m ON p.id = m.plano_id AND m.status = 'ativa'
GROUP BY p.id, p.nome
ORDER BY total_alunos DESC;

-- 6. A tabela mágica DUAL
SELECT SYSDATE FROM dual;
SELECT SYSTIMESTAMP FROM dual;