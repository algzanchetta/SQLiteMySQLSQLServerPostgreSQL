-- Não precisa de CREATE DATABASE nem USE.

-- ============================================
-- MÓDULO 1: NÚCLEO (Clientes e Planos)
-- ============================================

CREATE TABLE planos (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome VARCHAR2(100) NOT NULL,
    descricao CLOB,
    preco_mensal NUMBER(10, 2) NOT NULL,
    duracao_meses NUMBER DEFAULT 1,
    beneficios CLOB,
    status VARCHAR2(20) DEFAULT 'ativo' CHECK (status IN ('ativo', 'inativo')),
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_planos_status ON planos(status);

CREATE TABLE alunos (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome VARCHAR2(200) NOT NULL,
    email VARCHAR2(200) UNIQUE NOT NULL,
    telefone VARCHAR2(20),
    data_nascimento DATE,
    cpf VARCHAR2(11) UNIQUE,
    endereco CLOB,
    data_cadastro TIMESTAMP DEFAULT SYSDATE,
    status VARCHAR2(20) DEFAULT 'ativa' CHECK (status IN ('ativa', 'inativa', 'suspenso')),
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_alunos_email ON alunos(email);
CREATE INDEX idx_alunos_cpf ON alunos(cpf);
CREATE INDEX idx_alunos_status ON alunos(status);

CREATE TABLE matriculas (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    aluno_id NUMBER NOT NULL REFERENCES alunos(id),
    plano_id NUMBER NOT NULL REFERENCES planos(id),
    data_inicio DATE NOT NULL,
    data_fim DATE NOT NULL,
    valor_total NUMBER(10, 2) NOT NULL,
    status VARCHAR2(20) DEFAULT 'ativa' CHECK (status IN ('ativa', 'cancelada', 'expirada')),
    observacoes CLOB,
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_matriculas_aluno ON matriculas(aluno_id);
CREATE INDEX idx_matriculas_plano ON matriculas(plano_id);
CREATE INDEX idx_matriculas_status ON matriculas(status);

CREATE TABLE pagamentos (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    matricula_id NUMBER NOT NULL REFERENCES matriculas(id),
    valor NUMBER(10, 2) NOT NULL,
    data_pagamento DATE,
    data_vencimento DATE NOT NULL,
    forma_pagamento VARCHAR2(20) CHECK (forma_pagamento IN ('dinheiro', 'cartao', 'pix', 'boleto')),
    status VARCHAR2(20) DEFAULT 'pendente' CHECK (status IN ('pendente', 'pago', 'atrasado', 'cancelado')),
    observacoes CLOB,
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_pagamentos_matricula ON pagamentos(matricula_id);
CREATE INDEX idx_pagamentos_status ON pagamentos(status);
CREATE INDEX idx_pagamentos_vencimento ON pagamentos(data_vencimento);

-- ============================================
-- MÓDULO 2: OPERACIONAL (Aulas e Equipe)
-- ============================================

CREATE TABLE instrutores (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome VARCHAR2(200) NOT NULL,
    email VARCHAR2(200) UNIQUE NOT NULL,
    telefone VARCHAR2(20),
    especialidade VARCHAR2(100),
    salario_base NUMBER(10, 2),
    data_contratacao DATE,
    status VARCHAR2(20) DEFAULT 'ativo' CHECK (status IN ('ativo', 'inativo')),
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_instrutores_email ON instrutores(email);
CREATE INDEX idx_instrutores_status ON instrutores(status);

CREATE TABLE modalidades (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome VARCHAR2(100) NOT NULL,
    descricao CLOB,
    duracao_minutos NUMBER DEFAULT 60,
    nivel_dificuldade VARCHAR2(20) CHECK (nivel_dificuldade IN ('iniciante', 'intermediario', 'avancado')),
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE TABLE aulas (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    modalidade_id NUMBER NOT NULL REFERENCES modalidades(id),
    instrutor_id NUMBER NOT NULL REFERENCES instrutores(id),
    data_hora TIMESTAMP NOT NULL,
    sala VARCHAR2(50),
    vagas_totais NUMBER DEFAULT 20,
    vagas_ocupadas NUMBER DEFAULT 0,
    status VARCHAR2(20) DEFAULT 'agendada' CHECK (status IN ('agendada', 'cancelada', 'realizada')),
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_aulas_data ON aulas(data_hora);
CREATE INDEX idx_aulas_instrutor ON aulas(instrutor_id);
CREATE INDEX idx_aulas_status ON aulas(status);

CREATE TABLE inscricoes_aula (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    aula_id NUMBER NOT NULL REFERENCES aulas(id),
    aluno_id NUMBER NOT NULL REFERENCES alunos(id),
    data_inscricao TIMESTAMP DEFAULT SYSDATE,
    status_presenca VARCHAR2(20) DEFAULT 'inscrito' CHECK (status_presenca IN ('inscrito', 'presente', 'ausente', 'cancelado')),
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP,
    CONSTRAINT unique_aula_aluno UNIQUE (aula_id, aluno_id)
);

CREATE INDEX idx_inscricoes_aula ON inscricoes_aula(aula_id);
CREATE INDEX idx_inscricoes_aluno ON inscricoes_aula(aluno_id);

-- ============================================
-- MÓDULO 3: E-COMMERCE (Loja)
-- ============================================

CREATE TABLE produtos (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome VARCHAR2(200) NOT NULL,
    descricao CLOB,
    categoria VARCHAR2(20) CHECK (categoria IN ('suplemento', 'roupa', 'acessorio', 'equipamento')),
    preco NUMBER(10, 2) NOT NULL,
    estoque NUMBER DEFAULT 0,
    estoque_minimo NUMBER DEFAULT 5,
    imagem_url VARCHAR2(500),
    status VARCHAR2(20) DEFAULT 'ativo' CHECK (status IN ('ativo', 'inativo')),
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_produtos_categoria ON produtos(categoria);
CREATE INDEX idx_produtos_status ON produtos(status);

CREATE TABLE pedidos (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    aluno_id NUMBER NOT NULL REFERENCES alunos(id),
    data_pedido TIMESTAMP DEFAULT SYSDATE,
    valor_total NUMBER(10, 2) NOT NULL,
    forma_pagamento VARCHAR2(20) CHECK (forma_pagamento IN ('dinheiro', 'cartao', 'pix', 'boleto')),
    status VARCHAR2(20) DEFAULT 'pendente' CHECK (status IN ('pendente', 'pago', 'enviado', 'entregue', 'cancelado')),
    observacoes CLOB,
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_pedidos_aluno ON pedidos(aluno_id);
CREATE INDEX idx_pedidos_status ON pedidos(status);

CREATE TABLE itens_pedido (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    pedido_id NUMBER NOT NULL REFERENCES pedidos(id),
    produto_id NUMBER NOT NULL REFERENCES produtos(id),
    quantidade NUMBER NOT NULL,
    preco_unitario NUMBER(10, 2) NOT NULL,
    subtotal NUMBER(10, 2) NOT NULL,
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_itens_pedido ON itens_pedido(pedido_id);
CREATE INDEX idx_itens_produto ON itens_pedido(produto_id);

-- ============================================
-- MÓDULO 4: APP MOBILE (Treinos)
-- ============================================

CREATE TABLE exercicios (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome VARCHAR2(100) NOT NULL,
    grupo_muscular VARCHAR2(50) NOT NULL,
    descricao CLOB,
    dificuldade VARCHAR2(20) CHECK (dificuldade IN ('facil', 'medio', 'dificil')),
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_exercicios_grupo ON exercicios(grupo_muscular);

CREATE TABLE treinos (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    aluno_id NUMBER NOT NULL REFERENCES alunos(id),
    data_treino DATE NOT NULL,
    duracao_minutos NUMBER,
    calorias_queimadas NUMBER,
    observacoes CLOB,
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_treinos_aluno ON treinos(aluno_id);
CREATE INDEX idx_treinos_data ON treinos(data_treino);

CREATE TABLE treino_exercicios (
    id NUMBER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    treino_id NUMBER NOT NULL REFERENCES treinos(id),
    exercicio_id NUMBER NOT NULL REFERENCES exercicios(id),
    series NUMBER,
    repeticoes NUMBER,
    peso NUMBER(5, 2),
    tempo_descanso_segundos NUMBER,
    observacoes CLOB,
    created_at TIMESTAMP DEFAULT SYSDATE,
    updated_at TIMESTAMP DEFAULT SYSDATE,
    deleted_at TIMESTAMP
);

CREATE INDEX idx_treino_exercicios_treino ON treino_exercicios(treino_id);
CREATE INDEX idx_treino_exercicios_exercicio ON treino_exercicios(exercicio_id);

-- ============================================
-- VIEWS
-- ============================================

CREATE OR REPLACE VIEW vw_alunos_ativos AS
SELECT 
    a.id, a.nome, a.email, a.telefone,
    p.nome AS plano, p.preco_mensal,
    m.data_inicio, m.data_fim, m.status AS status_matricula
FROM alunos a
INNER JOIN matriculas m ON a.id = m.aluno_id
INNER JOIN planos p ON m.plano_id = p.id
WHERE m.status = 'ativa' 
  AND m.deleted_at IS NULL 
  AND a.deleted_at IS NULL;

CREATE OR REPLACE VIEW vw_pagamentos_atrasados AS
SELECT 
    p.id, a.nome AS aluno, a.email, p.valor, p.data_vencimento,
    (SYSDATE - p.data_vencimento) AS dias_atraso,
    p.forma_pagamento
FROM pagamentos p
INNER JOIN matriculas m ON p.matricula_id = m.id
INNER JOIN alunos a ON m.aluno_id = a.id
WHERE p.status = 'pendente' 
  AND p.data_vencimento < SYSDATE 
  AND p.deleted_at IS NULL;

